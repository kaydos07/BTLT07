<Window x:Class="MiniPiano.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Piano - Luyện nốt nhạc"
        Width="1020" Height="790" MinWidth="750" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="WhitePianoKey" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#243348" />
            <Setter Property="BorderBrush" Value="#BAC5D2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,0,0,17" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="BlackPianoKey" TargetType="Button">
            <Setter Property="Background" Value="#1F2937" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#111827" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0,0,0,14" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
    </Window.Resources>

    <Grid Margin="25,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="MINI PIANO" Foreground="#1D4ED8"
                       FontWeight="Bold" FontSize="13" />
            <TextBlock Text="Chơi nhạc bằng bàn phím hoặc chuột"
                       FontSize="26" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock Text="Phím trắng: A S D F G H J K    |    Phím đen: W E T Y U"
                       FontSize="14" Foreground="#475569" Margin="0,7,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="#DFE7F2" CornerRadius="14"
                Padding="14" Margin="0,0,0,17">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Center">
                <Grid Width="800" Height="240">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PianoC4" Grid.Column="0" Tag="C4" Style="{StaticResource WhitePianoKey}" Click="PianoKey_Click"><StackPanel><TextBlock Text="C4" HorizontalAlignment="Center"/><TextBlock Text="A" HorizontalAlignment="Center" FontWeight="Bold"/></StackPanel></Button>
                        <Button x:Name="PianoD4" Grid.Column="1" Tag="D4" Style="{StaticResource WhitePianoKey}" Click="PianoKey_Click"><StackPanel><TextBlock Text="D4" HorizontalAlignment="Center"/><TextBlock Text="S" HorizontalAlignment="Center" FontWeight="Bold"/></StackPanel></Button>
                        <Button x:Name="PianoE4" Grid.Column="2" Tag="E4" Style="{StaticResource WhitePianoKey}" Click="PianoKey_Click"><StackPanel><TextBlock Text="E4" HorizontalAlignment="Center"/><TextBlock Text="D" HorizontalAlignment="Center" FontWeight="Bold"/></StackPanel></Button>
                        <Button x:Name="PianoF4" Grid.Column="3" Tag="F4" Style="{StaticResource WhitePianoKey}" Click="PianoKey_Click"><StackPanel><TextBlock Text="F4" HorizontalAlignment="Center"/><TextBlock Text="F" HorizontalAlignment="Center" FontWeight="Bold"/></StackPanel></Button>
                        <Button x:Name="PianoG4" Grid.Column="4" Tag="G4" Style="{StaticResource WhitePianoKey}" Click="PianoKey_Click"><StackPanel><TextBlock Text="G4" HorizontalAlignment="Center"/><TextBlock Text="G" HorizontalAlignment="Center" FontWeight="Bold"/></StackPanel></Button>
                        <Button x:Name="PianoA4" Grid.Column="5" Tag="A4" Style="{StaticResource WhitePianoKey}" Click="PianoKey_Click"><StackPanel><TextBlock Text="A4" HorizontalAlignment="Center"/><TextBlock Text="H" HorizontalAlignment="Center" FontWeight="Bold"/></StackPanel></Button>
                        <Button x:Name="PianoB4" Grid.Column="6" Tag="B4" Style="{StaticResource WhitePianoKey}" Click="PianoKey_Click"><StackPanel><TextBlock Text="B4" HorizontalAlignment="Center"/><TextBlock Text="J" HorizontalAlignment="Center" FontWeight="Bold"/></StackPanel></Button>
                        <Button x:Name="PianoC5" Grid.Column="7" Tag="C5" Style="{StaticResource WhitePianoKey}" Click="PianoKey_Click"><StackPanel><TextBlock Text="C5" HorizontalAlignment="Center"/><TextBlock Text="K" HorizontalAlignment="Center" FontWeight="Bold"/></StackPanel></Button>
                    </Grid>
                    <Canvas>
                        <Button x:Name="PianoCSharp4" Tag="C#4" Canvas.Left="72" Width="56" Height="150" Style="{StaticResource BlackPianoKey}" Click="PianoKey_Click"><StackPanel><TextBlock Text="C#4" HorizontalAlignment="Center"/><TextBlock Text="W" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="PianoDSharp4" Tag="D#4" Canvas.Left="172" Width="56" Height="150" Style="{StaticResource BlackPianoKey}" Click="PianoKey_Click"><StackPanel><TextBlock Text="D#4" HorizontalAlignment="Center"/><TextBlock Text="E" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="PianoFSharp4" Tag="F#4" Canvas.Left="372" Width="56" Height="150" Style="{StaticResource BlackPianoKey}" Click="PianoKey_Click"><StackPanel><TextBlock Text="F#4" HorizontalAlignment="Center"/><TextBlock Text="T" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="PianoGSharp4" Tag="G#4" Canvas.Left="472" Width="56" Height="150" Style="{StaticResource BlackPianoKey}" Click="PianoKey_Click"><StackPanel><TextBlock Text="G#4" HorizontalAlignment="Center"/><TextBlock Text="Y" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="PianoASharp4" Tag="A#4" Canvas.Left="572" Width="56" Height="150" Style="{StaticResource BlackPianoKey}" Click="PianoKey_Click"><StackPanel><TextBlock Text="A#4" HorizontalAlignment="Center"/><TextBlock Text="U" FontWeight="Bold" HorizontalAlignment="Center"/></StackPanel></Button>
                    </Canvas>
                </Grid>
            </Viewbox>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="BÀI HÁT LUYỆN TẬP" FontSize="12" FontWeight="Bold"
                       Foreground="#475569" Margin="0,0,0,6" />
            <ComboBox x:Name="SongCombo" Width="350" Height="38"
                      HorizontalAlignment="Left" FontSize="14"
                      SelectionChanged="SongCombo_SelectionChanged" />
            <TextBlock x:Name="SongDescription" Foreground="#64748B"
                       FontSize="13" TextWrapping="Wrap" Margin="0,7,0,10" />
            <WrapPanel>
                <Button x:Name="ModeButton" Style="{StaticResource ActionButton}"
                        Content="Chuyển sang chơi tự do" Click="ToggleMode_Click"/>
                <Button Style="{StaticResource ActionButton}"
                        Content="Luyện lại từ đầu" Click="Restart_Click"/>
                <Button Style="{StaticResource ActionButton}"
                        Content="▶ Nghe mẫu" Click="ListenSample_Click"/>
                <Button Style="{StaticResource ActionButton}"
                        Content="■ Dừng nghe" Click="StopSample_Click"/>
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="3" Background="White" CornerRadius="14"
                Padding="18" BorderBrush="#DDE5EF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="TargetText" FontSize="18" FontWeight="SemiBold"
                           Foreground="#0F172A" TextWrapping="Wrap"/>
                <TextBlock x:Name="ProgressText" Grid.Row="1" Foreground="#475569"
                           Margin="0,6,0,12" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="NoteStrip" />
                </ScrollViewer>
                <TextBlock x:Name="FeedbackText" Grid.Row="3" FontSize="14"
                           Foreground="#1D4ED8" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <TextBlock Grid.Row="4" Margin="0,10,0,0"
                   Text="Mỗi ô trong bản nhạc ghi tên nốt ở trên và phím cần nhấn ở dưới. Ô màu xanh là nốt tiếp theo."
                   FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
    </Grid>
</Window>
